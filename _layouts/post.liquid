---
layout: default
---
{% assign tags = page.tags | join: '' %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-meta">
      Created on {{ page.date | date: '%B %d, %Y' }}
      {% if page.author %}by {{ page.author }}{% endif %}
      {% if page.last_updated %}, last updated on {{ page.last_updated | date: '%B %d, %Y' }}{% endif %}
      {% if page.meta %}• {{ page.meta }}{% endif %}
    </p>
    <p class="post-tags">
      {% if tags != '' %}
        {% for tag in page.tags %}
          <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}
          {% unless forloop.last %}
            &nbsp;
          {% endunless %}
        {% endfor %}
      {% endif %}
    </p>
  </header>

  {% if page.coin_header and page.coins.size > 0 %}
    {% for slug in page.coins %}
      {% assign hcoin = site.coins | where: "slug", slug | first %}
      {% if hcoin %}
        <div class="post-coin-header">
          <div class="post-coin-images">
            {% if hcoin.image_obverse %}
              <div>
                {% assign obv_alt = hcoin.title | append: " - Obverse" %}
                {% assign obv_path = "assets/img/" | append: hcoin.image_obverse %}
                {% include figure.liquid path=obv_path alt=obv_alt zoomable=true %}
                <p class="image-label">Obverse{% if hcoin.obverse_description %}: {{ hcoin.obverse_description }}{% endif %}</p>
              </div>
            {% endif %}
            {% if hcoin.image_reverse %}
              <div>
                {% assign rev_alt = hcoin.title | append: " - Reverse" %}
                {% assign rev_path = "assets/img/" | append: hcoin.image_reverse %}
                {% include figure.liquid path=rev_path alt=rev_alt zoomable=true %}
                <p class="image-label">Reverse{% if hcoin.reverse_description %}: {{ hcoin.reverse_description }}{% endif %}</p>
              </div>
            {% endif %}
          </div>
          <p class="post-coin-caption">
            <a href="{{ hcoin.url | relative_url }}">{{ hcoin.title }}</a>
            {% if hcoin.date_minted %}&middot; {{ hcoin.date_minted }}{% endif %}
            {% if hcoin.reference %}&middot; {{ hcoin.reference }}{% endif %}
          </p>
        </div>
      {% endif %}
    {% endfor %}
  {% endif %}

  <article class="post-content">
    {% if page.toc and page.toc.beginning %}
      <div id="table-of-contents">
        {% toc %}
      </div>
      <hr>
    {% endif %}
    <div id="markdown-content">
      {{ content }}
    </div>
  </article>

  {% if page.coins.size > 0 %}
    <div class="post-coins">
      <h4>Coins in this post</h4>
      <div class="post-coins-grid">
        {% for slug in page.coins %}
          {% assign coin = site.coins | where: "slug", slug | first %}
          {% if coin %}
            <a href="{{ coin.url | relative_url }}" class="post-coin">
              {% if coin.image_obverse %}
                <img src="{{ coin.image_obverse | prepend: '/assets/img/' | relative_url }}" alt="{{ coin.title }}" loading="lazy">
              {% endif %}
              <span>{{ coin.title }}</span>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <div class="post-back">
    <a href="{{ '/blog/' | relative_url }}">&larr; Back to Blog</a>
  </div>

  {% if page.citation %}
    {% include citation.liquid %}
  {% endif %}

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --group_by none --cited_in_order %}
    </div>
  {% endif %}

  {% if site.related_blog_posts and site.related_blog_posts.enabled %}
    {% if page.related_posts == null or page.related_posts %}
      {% include related_posts.liquid %}
    {% endif %}
  {% endif %}

  {% if site.disqus_shortname and page.disqus_comments %}
    {% include disqus.liquid %}
  {% endif %}
  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>

<style>
.post-coin-header {
  margin: 1.5rem 0 2rem;
}

.post-coin-images {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 340px));
  gap: 2rem;
  justify-content: center;
}

.post-coin-images img {
  width: 100%;
  height: auto;
  border-radius: 8px;
  box-shadow: 0 4px 6px rgba(0,0,0,0.1);
}

.post-coin-images .image-label {
  text-align: center;
  font-style: italic;
  color: var(--global-text-color-light);
  margin-top: 0.5rem;
  font-size: 0.9rem;
  line-height: 1.4;
}

.post-coin-caption {
  text-align: center;
  color: var(--global-text-color-light);
  margin-top: 1rem;
}

@media (max-width: 576px) {
  .post-coin-images {
    grid-template-columns: 1fr;
  }
}

.post-coins {
  margin-top: 3rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--global-divider-color);
}

.post-coins-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 1.5rem;
}

.post-coin {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120px;
  text-align: center;
  font-size: 0.85rem;
  text-decoration: none;
}

.post-coin img {
  width: 100px;
  height: 100px;
  object-fit: contain;
  background: #000;
  border-radius: 50%;
  padding: 4px;
  margin-bottom: 0.5rem;
}

.post-back {
  margin-top: 2rem;
}
</style>
